{
  "schemaVersion": 1,
  "id": "ballsclient",
  "version": "${version}",
  "name": "BallsClient",
  "description": "Comprehensive client-side utility and quality-of-life suite for Minecraft (26.1 - 26.3) with 620+ modules.",
  "authors": [
    "slopgobblercobbler",
    "Balls Client Contributors"
  ],
  "contact": {
    "homepage": "https://github.com/slopgobblercobbler/balls-client",
    "sources": "https://github.com/slopgobblercobbler/balls-client",
    "issues": "https://github.com/slopgobblercobbler/balls-client/issues"
  },
  "license": "Apache-2.0",
  "icon": "assets/ballsclient/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.ballsclient.fabric263.BallsClientFabric263"
    ]
  },
  "mixins": [
    "ballsclient.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": ">=26.1 <=26.3",
    "java": ">=25"
  },
  "suggests": {
    "fabric-api": "*",
    "modmenu": "*"
  }
}
