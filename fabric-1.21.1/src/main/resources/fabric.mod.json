{
  "schemaVersion": 1,
  "id": "ballsclient",
  "version": "${version}",
  "name": "BallsClient",
  "description": "Comprehensive client-side utility and quality-of-life suite for Minecraft (1.20.5 - 1.21.1) with 620+ modules.",
  "authors": [
    "slopgobblercobbler",
    "Balls Client Contributors"
  ],
  "contact": {
    "homepage": "https://github.com/slopgobblercobbler/balls-client",
    "sources": "https://github.com/slopgobblercobbler/balls-client",
    "issues": "https://github.com/slopgobblercobbler/balls-client/issues"
  },
  "license": "Apache-2.0",
  "icon": "assets/ballsclient/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.ballsclient.fabric1211.BallsClientFabric1211"
    ]
  },
  "mixins": [
    "ballsclient.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": ">=1.20.5 <=1.21.1",
    "java": ">=21"
  },
  "suggests": {
    "fabric-api": "*",
    "modmenu": "*"
  }
}
